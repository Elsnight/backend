{
  "name": "rescate-fresco-backend",
  "version": "1.0.0",
  "description": "Backend de economía circular contra el desperdicio de alimentos",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "postinstall": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.cjs",
    "db:seed:carga": "node prisma/seed-carga.cjs",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "start:prod": "prisma migrate deploy && node src/app.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "prisma": "^6.15.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1"
  }
}
